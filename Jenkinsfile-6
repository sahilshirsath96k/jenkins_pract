pipeline {
  agent {
    label 'linux-agent'
  }
  environment {
    APP_NAME = 'demo'
  }
  stages {
    stage ('Build') {
      environment {
        BUILD_MODE = 'production'
      }
      steps {
        echo "Building app $APP_NAME mode $BUILD_MODE"
      }
    }
    stage ('Test') {
      parallel {
        stage('Unit') { steps { sh ' echo unit tests ' } }
        stage('AB test') { steps { sh 'echo AB testing' } }
      } 
    }
    stage ('Approve') {
      steps {
        input message: 'Deploy to production'
      }
    }
    stage ('Deploy') {
      steps {
        echo "Deploying the Application"
      }
    }
  }
}
